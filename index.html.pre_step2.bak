<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="UniPPI-OWL v1.8 — Universal Structure-to-Affinity &amp; Atomic Interface Auditing Resource for AlphaFold3 and Experimental Complexes.">
    <link rel="canonical" href="https://soumyajitmandal06-gif.github.io/unippi-owl/">
  <meta name="keywords" content="UniPPI-OWL, UniPPI-OWL v1.8, AlphaFold3 binding free energy, structure to affinity, protein-protein interaction calculator, PAE, ipTM, PRODIGY">
  <meta property="og:title" content="UniPPI-OWL v1.8 (unippiowl) | Universal Structure-to-Affinity Resource">
  <meta property="og:url" content="https://soumyajitmandal06-gif.github.io/unippi-owl/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "UniPPI-OWL",
    "alternateName": ["unippiowl", "unippi-owl", "UniPPI-OWL v1.8"],
    "url": "https://soumyajitmandal06-gif.github.io/unippi-owl/",
    "applicationCategory": "ScientificApplication",
    "operatingSystem": "Web Browser, Linux, Windows, macOS",
    "author": {
      "@type": "Person",
      "name": "Soumyajit Mandal",
      "affiliation": "Central University of Rajasthan"
    }
  }
  </script>
  <title>UniPPI-OWL v1.8 | Universal Structure-to-Affinity Resource</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/3Dmol/2.0.4/3Dmol-min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <style>
    :root {
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --bg-subtle: #f1f5f9;
      --bg-dark: #0f172a;
      --text-main: #0f172a;
      --text-muted: #475569;
      --text-light: #64748b;
      --border: #e2e8f0;
      --border-strong: #cbd5e1;
      --primary: #0f4c81;
      --primary-hover: #0a355c;
      --primary-soft: #e0f2fe;
      --emerald: #047857;
      --emerald-bg: #d1fae5;
      --amber: #b45309;
      --amber-bg: #fef3c7;
      --rose: #be123c;
      --rose-bg: #ffe4e6;
      --radius: 10px;
      --shadow: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-page);
      color: var(--text-main);
      line-height: 1.55;
      font-size: 15px;
    }

    .lab-header {
      background: var(--bg-dark);
      color: #f8fafc;
      padding: 10px 24px;
      border-bottom: 1px solid #1e293b;
      font-size: 13px;
    }
    .lab-header-inner {
      max-width: 1260px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .lab-brand {
      color: #f8fafc;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .lab-name { font-weight: 700; letter-spacing: 0.05em; color: #38bdf8; }
    .lab-tagline { color: #cbd5e1; }
    .lab-affiliation { color: #94a3b8; font-size: 12px; }
    .lab-nav { display: flex; gap: 18px; }
    .lab-nav a { color: #cbd5e1; text-decoration: none; font-size: 12.5px; }
    .lab-nav a:hover { color: #ffffff; }

    .resource-nav {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }
    .resource-nav-inner {
      max-width: 1260px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }
    .wordmark {
      text-decoration: none;
      color: var(--text-main);
      font-size: 19px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .wordmark strong { font-weight: 800; letter-spacing: -0.02em; color: var(--primary); }
    .wordmark span {
      font-size: 12px;
      font-family: var(--font-mono);
      background: var(--primary-soft);
      color: var(--primary);
      padding: 2px 7px;
      border-radius: 99px;
      font-weight: 600;
    }
    .resource-links { display: flex; gap: 20px; flex-wrap: wrap; }
    .resource-links a {
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 500;
      font-size: 14px;
    }
    .resource-links a:hover { color: var(--primary); }

    main {
      max-width: 1260px;
      margin: 0 auto;
      padding: 28px 24px 64px;
      display: flex;
      flex-direction: column;
      gap: 26px;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.55fr 1fr;
      gap: 28px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 30px;
      box-shadow: var(--shadow);
      align-items: center;
    }
    @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }
    .eyebrow {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--primary);
      margin-bottom: 8px;
    }
    .hero h1 { font-size: 32px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 6px; }
    .hero h2 { font-size: 17px; font-weight: 600; color: var(--text-muted); margin-bottom: 14px; }
    .lead { color: var(--text-muted); margin-bottom: 20px; font-size: 14.5px; }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 9px 16px;
      border-radius: 7px;
      font-weight: 600;
      font-size: 13.5px;
      cursor: pointer;
      text-decoration: none;
      border: 1px solid transparent;
      transition: all 0.15s ease;
    }
    .btn-primary { background: var(--primary); color: #ffffff; }
    .btn-primary:hover { background: var(--primary-hover); }
    .btn-secondary { background: var(--bg-subtle); color: var(--text-main); border-color: var(--border-strong); }
    .btn-secondary:hover { background: #e2e8f0; }
    .btn-sm { padding: 6px 12px; font-size: 12.5px; }

    .model-card {
      background: var(--bg-subtle);
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      overflow: hidden;
    }
    .model-card-head {
      background: var(--bg-dark);
      color: #ffffff;
      padding: 10px 16px;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.03em;
      display: flex;
      justify-content: space-between;
    }
    .model-row {
      display: flex;
      justify-content: space-between;
      padding: 8.5px 16px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }
    .model-row:last-child { border-bottom: none; }
    .model-row span { color: var(--text-muted); }
    .model-row strong { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-main); }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px 26px;
      box-shadow: var(--shadow);
    }
    .section-kicker {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
      margin-bottom: 4px;
    }
    .card-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .card-head h2 { font-size: 20px; font-weight: 700; }

    .dropzone {
      border: 2px dashed var(--border-strong);
      border-radius: 8px;
      background: var(--bg-subtle);
      padding: 22px;
      text-align: center;
      margin-bottom: 14px;
      transition: all 0.2s;
    }
    .dropzone:hover, .dropzone.dragover { border-color: var(--primary); background: #e0f2fe; }
    .param-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
      gap: 14px;
      background: var(--bg-subtle);
      padding: 14px 16px;
      border-radius: 8px;
      border: 1px solid var(--border);
      margin-bottom: 16px;
    }
    .param-bar label {
      display: flex;
      flex-direction: column;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      gap: 5px;
    }
    .param-bar input, .param-bar select {
      padding: 7px 10px;
      border: 1px solid var(--border-strong);
      border-radius: 6px;
      font-size: 13px;
      font-family: var(--font-mono);
      background: #ffffff;
    }

    .status-banner {
      padding: 12px 18px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 13.5px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .status-banner.ok { background: var(--emerald-bg); color: var(--emerald); border: 1px solid #a7f3d0; }

    .meta-strip {
      font-size: 12.5px;
      color: var(--text-muted);
      background: var(--bg-subtle);
      padding: 8px 14px;
      border-radius: 6px;
      margin-bottom: 16px;
      font-family: var(--font-mono);
    }
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }
    .summary-metric {
      border: 1px solid var(--border);
      background: var(--bg-subtle);
      padding: 12px 14px;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .summary-metric.primary-metric {
      background: var(--primary-soft);
      border-color: #bae6fd;
    }
    .summary-metric span { font-size: 11.5px; color: var(--text-muted); font-weight: 600; }
    .summary-metric strong { font-size: 17.5px; font-family: var(--font-mono); color: var(--text-main); }

    .badge-call {
      display: inline-block;
      padding: 2px 9px;
      border-radius: 99px;
      font-size: 11.5px;
      font-weight: 700;
      font-family: var(--font-mono);
    }
    .badge-above { background: var(--emerald-bg); color: var(--emerald); }
    .badge-mod { background: var(--amber-bg); color: var(--amber); }
    .badge-below { background: var(--rose-bg); color: var(--rose); }

    .descriptor-panel {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 16px;
    }
    .descriptor-panel h3 { font-size: 13px; font-weight: 700; margin-bottom: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .descriptor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 12px;
    }
    .descriptor {
      background: var(--bg-page);
      border: 1px solid var(--border);
      padding: 10px 14px;
      border-radius: 6px;
      display: flex;
      flex-direction: column;
    }
    .descriptor span { font-size: 12px; color: var(--text-muted); }
    .descriptor strong { font-size: 15.5px; font-family: var(--font-mono); margin-top: 2px; }

    .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 8px; }
    table { width: 100%; border-collapse: collapse; font-size: 12.5px; text-align: left; }
    th {
      background: var(--bg-subtle);
      padding: 10px 11px;
      font-weight: 700;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border-strong);
      white-space: nowrap;
    }
    td {
      padding: 9.5px 11px;
      border-bottom: 1px solid var(--border);
      font-family: var(--font-mono);
      white-space: nowrap;
    }
    tr:hover td { background: #f0f9ff; cursor: pointer; }
    tr.selected-row td { background: var(--primary-soft); font-weight: 600; }

    .workbench-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 20px;
      margin-top: 14px;
    }
    @media (max-width: 980px) { .workbench-grid { grid-template-columns: 1fr; } }
    .mol-container {
      width: 100%;
      height: 430px;
      position: relative;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      background: #0f172a;
      overflow: hidden;
    }
    .mut-box {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px;
      background: var(--bg-subtle);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .svg-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 14px;
    }
    @media (max-width: 900px) { .svg-grid { grid-template-columns: 1fr; } }
    .svg-panel {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px;
      background: #ffffff;
      text-align: center;
    }

    .patterns-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 16px;
      margin-top: 14px;
    }
    .pattern-card {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px;
      background: var(--bg-subtle);
    }
    .pattern-label {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 2px 8px;
      border-radius: 4px;
      background: var(--primary);
      color: #fff;
      margin-bottom: 8px;
    }
    .pattern-card h3 { font-size: 15px; margin-bottom: 6px; }
    .pattern-card p { font-size: 13px; color: var(--text-muted); }

    .scope-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 20px;
      margin-top: 16px;
    }
    @media (max-width: 850px) { .scope-grid { grid-template-columns: 1fr; } }
    .scope-box {
      background: var(--bg-subtle);
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      padding: 16px 18px;
      font-size: 13.5px;
    }
    .scope-box ul { margin-left: 18px; margin-top: 8px; color: var(--text-muted); }
    .scope-box li { margin-bottom: 4px; }

    footer {
      border-top: 1px solid var(--border);
      padding: 28px 24px;
      background: var(--bg-card);
      font-size: 13px;
      color: var(--text-muted);
    }
    .footer-inner {
      max-width: 1260px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
    }
  </style>
</head>
<body>

  <header class="lab-header">
    <div class="lab-header-inner">
      <div class="lab-brand">
        <span class="lab-name">UNIPPI-OWL v1.8</span>
        <span class="lab-tagline">Universal Structure-to-Affinity &amp; Atomic Interface Auditing Engine</span>
        <span class="lab-affiliation">Dual-Layer CLI + Zero-Server Browser Architecture · AlphaFold3, AF2, ESM3, Boltz-1 &amp; Experimental PDB/mmCIF</span>
      </div>
      <nav class="lab-nav">
        <a href="#analyze">Analyze</a>
        <a href="#workbench">3D &amp; Contact Inspector</a>
        <a href="#interpretation">Biophysical Tracks</a>
        <a href="#interpretation-guide">Patterns &amp; Scope</a>
      </nav>
    </div>
  </header>

  <div class="resource-nav">
    <div class="resource-nav-inner">
      <a class="wordmark" href="#top"><strong>UniPPI-OWL</strong><span>v1.8 Frozen</span></a>
      <nav class="resource-links">
        <a href="#about">Overview</a>
        <a href="#analyze">Batch &amp; Single Input</a>
        <a href="#workbench">3D &amp; Contact Inspector</a>
        <a href="#svg-maps">Vector Contact &amp; PAE Maps</a>
        <a href="#interpretation-guide">Mechanistic Patterns</a>
      </nav>
    </div>
  </div>

  <main id="top">
    <section class="hero" id="about">
      <div>
        <div class="eyebrow">POST-ALPHAFOLD3 THERMODYNAMICS · UNIVERSAL BIOMOLECULAR PRIORITIZATION</div>
        <h1>UniPPI-OWL</h1>
        <h2>Bridging 3D structure predictions to physical binding affinity (ΔG, K<sub>d</sub>) and atomic interface contact networks</h2>
        <p class="lead">
          A zero-install, 100% client-side computational resource that evaluates <strong>hydrophobic coiled-coils, globular electrostatic/H-bond complexes, protein–nucleic acid, and protein–ligand interfaces</strong> while silencing disordered loop hallucinations (IDRs) and automating FoldX/Rosetta format sanitization.
        </p>
        <div class="hero-actions">
          <button class="btn btn-primary" onclick="loadAF3FiveModelEnsemble()">Load Sample 5-Model AF3 Ensemble (model_0–model_4)</button>
          <button class="btn btn-secondary" onclick="loadCrossKingdomBenchmark()">Load 6-Complex Multi-Mechanism Benchmark</button>
          <button class="btn btn-secondary" style="border-color:var(--primary); color:var(--primary);" onclick="loadUniversalModalityShowcase()">Load Universal 5-Modality Suite (PPI + DNA + Ligand + Metal + Monomer)</button>
          <a class="btn btn-secondary" href="#interpretation-guide">Scientific Scope &amp; Pattern Guide</a>
        </div>
      </div>

      <aside class="model-card" aria-label="UniPPI-v1.8 model summary">
        <div class="model-card-head"><span>UniPPI-v1.8 at a glance</span><span>FROZEN</span></div>
        <div class="model-row"><span>Scientific model</span><strong>UniPPI-v1.8 (Hybrid ΔG + LIS)</strong></div>
        <div class="model-row"><span>Physicochemical channels</span><strong>8 channels (PTM/Metal) + 64-pt SASA</strong></div>
        <div class="model-row"><span>Decision threshold (UIS)</span><strong>0.5000 (High-Conf: 0.6500)</strong></div>
        <div class="model-row"><span>Validation panel</span><strong>6 Cross-Mechanism Complexes</strong></div>
        <div class="model-row"><span>Execution &amp; privacy</span><strong>100% Client-Side Browser / CLI</strong></div>
      </aside>
    </section>

    <section class="card" id="analyze">
      <div class="card-head">
        <div>
          <div class="section-kicker">End-to-End AlphaFold3 Server &amp; Experimental Batch Pipeline</div>
          <h2>1. Universal Biomolecular Workflow &amp; Multi-Format Batch File Handler</h2>
          <p style="color:var(--text-muted); font-size:13.5px;">UniPPI-OWL is a post-prediction biophysical auditing engine: generate 3D complexes from full-length amino acid sequences in <strong>AlphaFold3 Server</strong> (or ColabFold / Boltz-1 / X-ray PDB), then upload the resulting <code>.cif</code>/<code>.pdb</code> coordinates and companion <code>.json</code> confidence files below as a batch.</p>
        </div>
      </div>

      <!-- Explicit 4-Step Workflow Strip Addressing Point 1 -->
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-bottom:18px;">
        <div style="background:var(--bg-subtle); border:1px solid var(--border-strong); border-left:4px solid var(--primary); border-radius:8px; padding:12px;">
          <div style="font-size:11px; font-weight:700; color:var(--primary); text-transform:uppercase;">Step 1 · AF3 Server Input</div>
          <div style="font-weight:700; font-size:13.5px; margin:3px 0;">Any Predictor or PDB Input</div>
          <div style="font-size:12px; color:var(--text-muted);">Accepts structures from <strong>AlphaFold3 Server</strong> (full-length multi-chain <code>.cif</code> + <code>.json</code> or <code>.zip</code> archives), <strong>ColabFold/AF2, Boltz-1, Chai-1, ESM3, HADDOCK</strong>, or <strong>RCSB PDB X-ray/Cryo-EM/NMR</strong>.</div>
        </div>
        <div style="background:var(--bg-subtle); border:1px solid var(--border-strong); border-left:4px solid var(--primary); border-radius:8px; padding:12px;">
          <div style="font-size:11px; font-weight:700; color:var(--primary); text-transform:uppercase;">Step 2 · Batch File Handler</div>
          <div style="font-weight:700; font-size:13.5px; margin:3px 0;">Auto-Pair .CIF/.PDB + .JSON</div>
          <div style="font-size:12px; color:var(--text-muted);">Upload multiple <code>.cif</code>, <code>.mmcif</code>, <code>.pdb</code>, <code>*_confidences.json</code> / <code>*_full_data_0.json</code> (PAE), and <code>*_summary_confidences.json</code> (ipTM) files together.</div>
        </div>
        <div style="background:var(--bg-subtle); border:1px solid var(--border-strong); border-left:4px solid var(--primary); border-radius:8px; padding:12px;">
          <div style="font-size:11px; font-weight:700; color:var(--primary); text-transform:uppercase;">Step 3 · Domain &amp; PTM Audit</div>
          <div style="font-weight:700; font-size:13.5px; margin:3px 0;">IDR-Immune Local PAE (LIS) &amp; PTM Audit</div>
          <div style="font-size:12px; color:var(--text-muted);">Isolates ordered coiled-coil/globular interfaces from disordered tails via local PAE (<code>LIS</code>) and audits phosphorylation &amp; divalent metal-ion bridges.</div>
        </div>
        <div style="background:var(--bg-subtle); border:1px solid var(--border-strong); border-left:4px solid var(--primary); border-radius:8px; padding:12px;">
          <div style="font-size:11px; font-weight:700; color:var(--primary); text-transform:uppercase;">Step 4 · Transparent Multi-Model ΔG</div>
          <div style="font-weight:700; font-size:13.5px; margin:3px 0;">Step-by-Step Equations &amp; Contact Table</div>
          <div style="font-size:12px; color:var(--text-muted);">Computes step-by-step confidence-weighted buried surface area (wBSA), 8-channel atomic contacts, PRODIGY &amp; physical solvation ΔG, and Kd across all AF3 models.</div>
        </div>
      </div>

      <!-- Visible Batch File Handler UI Addressing Point 4 -->
      <div class="dropzone" id="dropzone" style="border:2px dashed var(--primary); background:#f0f9ff; padding:20px; margin-bottom:16px;">
        <div style="font-weight:800; font-size:15.5px; color:var(--primary); margin-bottom:6px;">BATCH STRUCTURE &amp; JSON FILE HANDLER (Drag &amp; Drop or Browse Files/Folders)</div>
        <p style="color:var(--text-muted); font-size:13px; margin-bottom:14px;">Accepts any batch of <code>.cif</code>, <code>.mmcif</code>, <code>.pdb</code> structures + companion AlphaFold3 <code>*_confidences.json</code>, <code>*_summary_confidences.json</code>, and <code>*_full_data_*.json</code> files (or precomputed <code>unippi_full_report.json</code>).</p>
        <div style="display:flex; justify-content:center; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px;">
          <label class="btn btn-primary btn-sm" style="cursor:pointer;">
            + Upload AF3 .ZIP or Batch Files (.CIF / .PDB / .JSON)
            <input type="file" id="fileInput" multiple accept=".zip,.cif,.mmcif,.pdb,.json,.ent,.pqr" style="display:none" onchange="handleFileSelect(this.files)">
          </label>
          <label class="btn btn-secondary btn-sm" style="cursor:pointer; border-color:var(--primary); color:var(--primary);">
            + Upload Entire AF3 Batch Folder
            <input type="file" id="folderInput" webkitdirectory directory multiple style="display:none" onchange="handleFileSelect(this.files)">
          </label>
          <button class="btn btn-secondary btn-sm" onclick="loadAF3FiveModelEnsemble()">Load 5-Model AF3 Ensemble (model_0–model_4)</button>
          <button class="btn btn-secondary btn-sm" onclick="downloadActiveRawAF3Pair()">Download Active Raw .CIF + _confidences.json Pair</button>
        </div>
        <div id="batchFileQueueWrap" style="text-align:left; background:#ffffff; border:1px solid var(--border-strong); border-radius:6px; padding:10px 12px; font-family:var(--font-mono); font-size:12px; max-height:150px; overflow-y:auto;">
          <div style="font-weight:700; color:var(--text-main); margin-bottom:4px;">Active Batch File Queue &amp; Structure-to-JSON Pairing Manifest:</div>
          <div id="batchFileQueueList" style="color:var(--text-muted);">Loaded built-in 6-complex authentic Arabidopsis VIP1 (At1g43700, 77-aa extended bZIP) &amp; bZIP61/bZIP34/GRF6 benchmark suite.</div>
        </div>
      </div>

      <div class="param-bar">
        <label>Heavy-Atom Cutoff d<sub>min</sub> (Å)
          <input type="number" id="cutoffInput" value="5.5" step="0.5" min="3.5" max="8.0" onchange="recomputeActiveSuite()">
        </label>
        <label>Temperature (Kelvin)
          <input type="number" id="tempInput" value="298.15" step="0.5" min="270" max="350" onchange="recomputeActiveSuite()">
        </label>
        <label>PAE Decay Constant λ<sub>PAE</sub> (Å)
          <input type="number" id="lambdaInput" value="8.0" step="0.5" min="2.0" max="25.0" onchange="recomputeActiveSuite()">
        </label>
        <label>Ionic Strength (mM NaCl)
          <input type="number" id="ionicInput" value="150" step="25" min="10" max="1000" onchange="recomputeActiveSuite()">
        </label>
        <label>Solution pH (Protonation)
          <input type="number" id="phInput" value="7.2" step="0.2" min="4.0" max="9.5" onchange="recomputeActiveSuite()">
        </label>
        <label>Report Depth
          <select id="reportModeSelect" onchange="renderActiveComplex()">
            <option value="detailed">Detailed report — Step-by-step math, UIS, ΔG, descriptors &amp; tracks</option>
            <option value="score">Score only — UIS &amp; threshold call</option>
          </select>
        </label>
      </div>
    </section>

    <div id="statusBanner" class="status-banner ok" style="display:none;">
      <span id="statusText">Analysis complete.</span>
      <span style="font-family:var(--font-mono); font-size:12px;">Model: UniPPI-v1.8 · Frozen Threshold: 0.5000 · Parity: 100% CLI Match</span>
    </div>

    <section class="card" id="leaderboardCard" style="display:none;">
      <div class="card-head">
        <div>
          <div class="section-kicker">Master Screening Leaderboard</div>
          <h2>Ranked Biomolecular Interfaces (<span id="complexCountLabel">0</span>)</h2>
          <p style="color:var(--text-muted); font-size:13px;">Click any model row below to inspect its step-by-step mathematical derivation, 3D interface structure, residue-by-residue contact list, and vector maps.</p>
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <button class="btn btn-secondary btn-sm" onclick="downloadMasterCSV()">Download Master CSV</button>
          <button class="btn btn-secondary btn-sm" onclick="downloadMasterTSV()">Download Master TSV</button>
          <button class="btn btn-secondary btn-sm" onclick="downloadSanitizedPDB()">Download Sanitized PDB</button>
          <button class="btn btn-secondary btn-sm" onclick="downloadLigandSDF()">Download Ligand SDF</button>
          <button class="btn btn-secondary btn-sm" onclick="downloadContactsCSV()">Download Contacts CSV</button>
        </div>
