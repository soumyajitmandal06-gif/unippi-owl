    <section class="card" id="interpretation" style="display:none;">
      <div class="card-head">
        <div>
          <div class="section-kicker">Context, Not Black-Box Score Fusion</div>
          <h2>Independent Biophysical &amp; Sequence Homology Evidence Tracks</h2>
          <p style="color:var(--text-muted); font-size:13.5px;">UniPPI-OWL evaluates global chain topology, local IDR-immune PAE coherence, solvation thermodynamics, structural integrity, and sequence mapping context as orthogonal tracks.</p>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Independent Track</th>
              <th>Observed Value(s)</th>
              <th>Biophysical &amp; Mechanistic Interpretation</th>
            </tr>
          </thead>
