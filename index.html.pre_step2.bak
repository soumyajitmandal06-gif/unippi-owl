    <section class="card" id="singleResultCard" style="display:none;">
      <div class="card-head">
        <div>
          <div class="section-kicker">Selected Interface Deep-Dive</div>
          <h2 id="activeComplexTitle">Complex Result</h2>
        </div>
        <span id="activeShaBadge" style="font-family:var(--font-mono); font-size:12px; background:var(--bg-subtle); padding:5px 10px; border-radius:6px; border:1px solid var(--border);">SHA-256: —</span>
      </div>

      <div class="meta-strip">
        Decision threshold: <code>0.5000</code> · High-confidence cutoff: <code>0.6500</code> · Scientific model: <code>UniPPI-v1.8</code> · Confidence regime: <code id="activeModeBadge">MODE_A_PRED_FULL</code>
      </div>

