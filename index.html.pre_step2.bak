      <div id="ensembleSummaryBanner" style="display:none; background:var(--primary-soft); border:1px solid #bae6fd; border-left:4px solid var(--primary); padding:10px 14px; border-radius:6px; margin-bottom:12px; font-family:var(--font-mono); font-size:12.5px;"></div>
      <div class="table-wrap">
